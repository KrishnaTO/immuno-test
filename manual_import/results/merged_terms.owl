        <owl:annotatedTarget>Any hepatocyte that is part of the liver lobule periportal region. These cells are primarily involved in oxidative energy metabolism.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29763190</oboInOwl:hasDbXref>
    </owl:Axiom>
