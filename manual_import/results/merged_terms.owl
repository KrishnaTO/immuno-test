        <oboInOwl:hasExactSynonym>mature natural killer T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mature natural killer T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
