        <oboInOwl:hasExactSynonym>liver NK cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>liver resident natural killer cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>liver-specific natural killer cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lr-NK</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#mouse_subset"/>
        <rdfs:comment>Liver-resident natural killer cells play a crucial role in modulating the immune response during inflammation by balancing cytotoxic activity and cytokine production, thereby contributing to the maintenance of liver homeostasis and protection against excessive tissue damage.</rdfs:comment>
