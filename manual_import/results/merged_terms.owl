        <oboInOwl:hasExactSynonym>gamma-delta T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gammadelta T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gd T cell</oboInOwl:hasRelatedSynonym>
