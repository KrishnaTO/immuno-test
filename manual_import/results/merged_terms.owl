        <oboInOwl:hasDbXref>NCIT:C12712</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:115976003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0015282</oboInOwl:hasDbXref>
