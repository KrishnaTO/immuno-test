        <oboInOwl:hasDbXref>CALOHA:TS-0452</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67763</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009279</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Ito cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hepatic perisinusoidal cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perisinusoidal cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fat-storing cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lipocyte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin A-storing cells</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Hepatic stellate cells are CD271-positive, desmin-positive, DDR-2-positive, GFAP-positive, synamin-positive, synaptophysin-positive, vimentin-positive, They are capable of producing angiotensin II, fibronectin, laminin, MMP-1, MMP-2, MMP-3, MMP-9, MMP-11, TGF-beta1, TIMP-1, TIMP-2, type I collagen, type III collagen, type IV collagen, and type VI collagen.</rdfs:comment>
        <rdfs:label>hepatic stellate cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000632</rdfs:seeAlso>
