    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0001065"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lymphocyte that lacks characteristic T cell, B cell, myeloid cell, and dendritic cell markers, that functions as part of the innate immune response to produce cytokines and other effector responses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dsd</oboInOwl:hasDbXref>
