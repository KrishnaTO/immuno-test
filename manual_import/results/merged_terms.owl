        <oboInOwl:hasDbXref>TAO:0000123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0023884</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Liver</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Liver</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>iecur</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>jecur</oboInOwl:hasRelatedSynonym>
