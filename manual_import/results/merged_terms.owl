        <oboInOwl:hasExactSynonym>DC2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IPC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-associated plasma cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interferon-producing cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphoid dendritic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pDC</oboInOwl:hasExactSynonym>
